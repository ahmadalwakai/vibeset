# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

!.env.example
/playwright-report
/test-results
/blob-report
/.tmp
/.playwright-mcp

# Native app local/generated files (iOS is generated on macOS)
/mobile/node_modules/
/mobile/.expo/
/mobile/dist/
/mobile/coverage/
/mobile/ios/
/mobile/android/
/mobile/build/
*.p8
*.p12
*.mobileprovision
