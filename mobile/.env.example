# Public origins only. The API/CDN must serve actual published Vibeset content.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_CDN_URL=

# Confirm these in the intended Apple Developer team; never invent registered IDs.
VIBESET_IOS_BUNDLE_ID=
VIBESET_IOS_WIDGET_BUNDLE_ID=
VIBESET_IOS_APP_GROUP=

# Set to 1 only for native prebuild/CI. JavaScript export may run without Apple IDs.
VIBESET_NATIVE_GENERATE=0
