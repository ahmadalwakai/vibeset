{
  "name": "vibeset-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios": "npm run check:native && expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "export:ios": "expo export --platform ios",
    "check:expo": "expo install --check",
    "prebuild:ios": "npm run check:native && expo prebuild --platform ios --no-install",
    "prebuild:ios:compile": "node --env-file-if-exists=.env.local --import tsx scripts/check-native-environment.ts --compile-only --prebuild",
    "check:native": "node --env-file-if-exists=.env.local --import tsx scripts/check-native-environment.ts",
    "check:native:compile": "node --env-file-if-exists=.env.local --import tsx scripts/check-native-environment.ts --compile-only"
  },
  "dependencies": {
    "@expo/ui": "~58.0.23",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "58.0.19",
    "expo-crypto": "~58.0.7",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-localization": "~58.0.5",
    "expo-media-library": "~58.0.12",
    "expo-sharing": "~58.0.20",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-widgets": "~58.0.23",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "overrides": {
    "@expo/cli": {
      "zod": "$zod"
    }
  },
  "type": "module"
}
