{
  "name": "vibeset",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "chakra:typegen": "chakra typegen ./design/system.ts",
    "db:generate": "dotenv -e .env.local -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "admin:grant": "dotenv -e .env.local -- tsx --conditions=react-server scripts/admin-user.ts --grant",
    "admin:revoke": "dotenv -e .env.local -- tsx --conditions=react-server scripts/admin-user.ts --revoke",
    "admin:list": "dotenv -e .env.local -- tsx --conditions=react-server scripts/admin-user.ts --list",
    "glyphs:build": "tsx scripts/generate-glyphs.ts",
    "fonts:fetch": "tsx scripts/fetch-fonts.ts",
    "render:sample": "tsx --conditions=react-server scripts/render-sample.ts",
    "themes:publish": "dotenv -e .env.local -- tsx --conditions=react-server scripts/publish-themes.ts",
    "themes:sample": "dotenv -e .env.local -- tsx --conditions=react-server scripts/dev-sample-theme.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@chakra-ui/react": "^3.37.0",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@neondatabase/serverless": "^1.2.0",
    "@phosphor-icons/core": "^2.1.1",
    "@phosphor-icons/react": "^2.1.10",
    "@resvg/resvg-js": "^2.6.2",
    "@vercel/functions": "^3.10.3",
    "better-auth": "^1.7.12",
    "culori": "^4.0.2",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "lz-string": "^1.5.0",
    "motion": "^12.43.0",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "react": "~19.2.9",
    "react-dom": "~19.2.9",
    "react-icons": "^5.7.0",
    "recharts": "^3.10.1",
    "resend": "^6.34.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@chakra-ui/cli": "^3.37.0",
    "@playwright/test": "^1.64.1",
    "@types/culori": "^4.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "~19.2",
    "@types/react-dom": "~19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  },
  "type": "module"
}
