# ─────────────────────────────────────────────────────────────
# Vibeset environment variables
# Copy to .env.local for development. On Vercel, set these per
# environment (Production / Preview). Never commit real values.
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Dev: the R2 bucket's public r2.dev URL. Production: https://cdn.vibeset.app
NEXT_PUBLIC_CDN_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev

# ── Neon (the Vercel integration injects both on Vercel) ─────
# Pooled connection — runtime queries
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Direct connection — migrations and scripts
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# ── Better Auth ──────────────────────────────────────────────
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Optional extra trusted origins, comma-separated (e.g. a staging domain)
BETTER_AUTH_TRUSTED_ORIGINS=
# Google Cloud Console → OAuth client (Web). Redirect: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (Resend, magic links) ──────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Vibeset <hello@vibeset.app>"

# ── Cloudflare R2 ────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# vibeset-dev for local/preview, vibeset-assets for production
R2_BUCKET=vibeset-dev

# ── Security (openssl rand -hex 32 for each) ─────────────────
IP_HASH_SALT=
CRON_SECRET=
INTERNAL_API_SECRET=

# ── Testing — NEVER enable in production ─────────────────────
# Enables email+password sign-in for e2e test users (env validation refuses it when VERCEL_ENV=production)
E2E_TEST_AUTH=0
# Neon branch used by integration tests (optional locally)
TEST_DATABASE_URL=
# Lint/typecheck-only CI runs
SKIP_ENV_VALIDATION=

# ── Optional ─────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
